# Arbco Tree Services - Environment Configuration

# Canonical Production URL (default: https://www.arbco.com.au)
NEXT_PUBLIC_SITE_URL=https://www.arbco.com.au

# Google Analytics 4 (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
# Set in Vercel Project Settings -> Environment Variables
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager (GTM) Container ID (e.g. GTM-XXXXXXX) - Optional if GA4 is used directly
NEXT_PUBLIC_GTM_ID=
